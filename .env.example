# TimeTrack Environment Configuration
# Copy this file to .env (or server/.env for backend settings).

# Backend API URL (Frontend)
VITE_API_URL="http://localhost:4000/api"

# Production app URL (Railway custom domain — apex is canonical,
# www.time-track.tech 301-redirects to it)
PRODUCTION_URL="https://time-track.tech"

# Server configuration template can be found in server/.env.example:
# - DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/timetrack_pre-prod?schema=public"
#   (or "postgresql://USER:PASSWORD@localhost:5433/timetrack_prod?schema=public" for production clone)
# - JWT_SECRET="your-generated-jwt-secret"
# - PORT=4000
# - CORS_ORIGIN="http://localhost:5173"
# - REDIS_URL="redis://127.0.0.1:6379"
