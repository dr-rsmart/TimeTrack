# TimeTrack server configuration template
# Copy to server/.env and fill in real values. NEVER commit the real .env.

# PostgreSQL connection string (REQUIRED)
# For local pre-production/development:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/timetrack_pre-prod?schema=public"
# For production clone:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/timetrack_prod?schema=public"

# JWT signing secret — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to boot without it, and refuses known-insecure defaults
# in production.
JWT_SECRET=""

# API port (default: 4000)
PORT=4000

# Allowed CORS origin(s), comma-separated (the frontend URL, default: http://localhost:5173)
# Local dev may include localhost + production origins, e.g.:
# CORS_ORIGIN="http://localhost:5173,https://time-track.tech,https://www.time-track.tech"
# PRODUCTION (Railway) must contain HTTPS, non-localhost origins only:
# CORS_ORIGIN="https://time-track.tech"
CORS_ORIGIN="http://localhost:5173"

# Redis connection URL for distributed rate limiting & SSE pub/sub (Optional, falls back to in-memory)
# Format: redis://[:password@]host[:port][/db-number] or use REDIS_HOST & REDIS_PORT
REDIS_URL="redis://127.0.0.1:6379"
# REDIS_HOST="127.0.0.1"
# REDIS_PORT=6379

# Optional: Google Maps API key (currently unused — geocoding uses Nominatim)
GOOGLE_MAPS_API_KEY=""

# Optional: performance-test bypass secret for the x-perf-bypass header.
# IGNORED entirely when NODE_ENV=production. Leave empty to disable.
PERF_TEST_SECRET=""

# Optional: re-clock-in protection window (seconds). After an employee clocks
# out, self-service clock-ins are rejected until this many seconds have passed
# (prevents "clocked out, instantly clocked back in" double punches).
# Admin/manager proxy punches and system-closed sessions bypass it.
# Default: 120. Set to 0 to disable.
# RECLOCK_GUARD_SECONDS=120

# Optional: strict geofence enforcement for clock-ins (default: true).
# Set to "false" ONLY for local testing — disables location validation.
# STRICT_GEOFENCE=true
