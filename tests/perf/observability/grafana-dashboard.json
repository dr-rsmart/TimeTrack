{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "TimeTrack k6 Stress Test Analytics — Phase A/B/C monitoring with abort-threshold alerting",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚨 Abort Threshold Status (fail-fast guards)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "title": "Error Rate (abort > 5%)",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 * sum(rate(k6_http_req_failed_total[1m])) / sum(rate(k6_http_reqs_total[1m]))",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1500 },
              { "color": "red", "value": 3000 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "title": "p99 Latency (abort > 3000ms)",
      "type": "gauge",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(k6_http_req_duration_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "title": "Host RAM (abort > 90%)",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "RAM %"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 95 }
            ]
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "title": "Host CPU (abort > 95%)",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "📈 k6 Load Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Active VUs",
      "type": "timeseries",
      "targets": [
        { "expr": "k6_vus", "legendFormat": "active VUs" },
        { "expr": "k6_vus_max", "legendFormat": "max VUs" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Throughput (req/s)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(k6_http_reqs_total[1m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Response Time Percentiles",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(k6_http_req_duration_bucket[1m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, sum(rate(k6_http_req_duration_bucket[1m])) by (le))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_bucket[1m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(k6_http_req_duration_bucket[1m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "🎯 Per-Scenario Latency (sequential isolation)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "title": "p95 by Scenario",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_bucket{scenario=\"health_check\"}[1m])) by (le))", "legendFormat": "S1 health" },
        { "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_bucket{scenario=\"concurrent_login\"}[1m])) by (le))", "legendFormat": "S2 login" },
        { "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_bucket{scenario=\"dashboard_load\"}[1m])) by (le))", "legendFormat": "S3 dashboard" },
        { "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_bucket{scenario=\"sse_connection\"}[1m])) by (le))", "legendFormat": "S4 sse" },
        { "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_bucket{scenario=\"db_query_stress\"}[1m])) by (le))", "legendFormat": "S5 db query" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "title": "Check Pass Rate by Scenario",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(k6_checks_total{scenario=\"health_check\"}[1m])) / sum(rate(k6_checks_total{scenario=\"health_check\"}[1m]) + rate(k6_checks_failed_total{scenario=\"health_check\"}[1m]))", "legendFormat": "S1 health" },
        { "expr": "sum(rate(k6_checks_total{scenario=\"concurrent_login\"}[1m])) / sum(rate(k6_checks_total{scenario=\"concurrent_login\"}[1m]) + rate(k6_checks_failed_total{scenario=\"concurrent_login\"}[1m]))", "legendFormat": "S2 login" },
        { "expr": "sum(rate(k6_checks_total{scenario=\"dashboard_load\"}[1m])) / sum(rate(k6_checks_total{scenario=\"dashboard_load\"}[1m]) + rate(k6_checks_failed_total{scenario=\"dashboard_load\"}[1m]))", "legendFormat": "S3 dashboard" },
        { "expr": "sum(rate(k6_checks_total{scenario=\"db_query_stress\"}[1m])) / sum(rate(k6_checks_total{scenario=\"db_query_stress\"}[1m]) + rate(k6_checks_failed_total{scenario=\"db_query_stress\"}[1m]))", "legendFormat": "S5 db" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "title": "🖥️ System Under Test — Host Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "RAM & Swap Usage",
      "type": "timeseries",
      "targets": [
        { "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "RAM %" },
        { "expr": "100 * (1 - node_memory_SwapFree_bytes / node_memory_SwapTotal_bytes)", "legendFormat": "Swap %" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Disk I/O Queue Length (abort > 2)",
      "type": "timeseries",
      "targets": [
        { "expr": "node_disk_io_time_weighted_seconds_total", "legendFormat": "{{device}} weighted io" },
        { "expr": "rate(node_disk_io_time_seconds_total[1m])", "legendFormat": "{{device}} active time" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "id": 12,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "CPU by Mode (iowait = disk pressure)",
      "type": "timeseries",
      "targets": [
        { "expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"user\"}[1m]))", "legendFormat": "user" },
        { "expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"system\"}[1m]))", "legendFormat": "system" },
        { "expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[1m]))", "legendFormat": "iowait" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 104,
      "title": "🗄️ Database & SSE Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 13,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "PostgreSQL Connections",
      "type": "timeseries",
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "{{state}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 14,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Custom Trends (login / dashboard / db / sse)",
      "type": "timeseries",
      "targets": [
        { "expr": "k6_tt_login_duration_p95", "legendFormat": "login p95" },
        { "expr": "k6_tt_dashboard_duration_p95", "legendFormat": "dashboard p95" },
        { "expr": "k6_tt_db_query_duration_p95", "legendFormat": "db query p95" },
        { "expr": "k6_tt_sse_handshake_duration_p95", "legendFormat": "sse handshake p95" }
      ]
    }
  ],
