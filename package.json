{
  "name": "tt-workforce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TimeTrack — multi-tenant time tracking, scheduling and payroll platform (rebuilt from TimeTrack)",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "cd server && npm run dev",
    "setup": "npm install && cd server && npm install && npm run db:setup",
    "seed": "cd server && npm run seed",
    "postinstall": "cd server && npm install",
    "build": "vite build && cd server && npm run build",
    "start": "cd server && npx prisma db push --accept-data-loss --schema=prisma/schema.prisma && cd .. && node server/dist/index.js",
    "typecheck": "tsc -p ./tsconfig.json --noEmit && cd server && npx tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predeploy": "node scripts/predeploy-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tanstack/react-query": "^5.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^13.1.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "decimal.js": "^10.6.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
