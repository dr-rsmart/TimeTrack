{
  "name": "TimeTrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "description": "TimeTrack — multi-tenant time tracking, scheduling and payroll platform (rebuilt from TimeTrack)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "cd server && npm run dev",
    "setup": "npm install && cd server && npm install && npm run db:setup",
    "seed": "cd server && npm run seed",
    "db:sync:prod": "node scripts/sync-prod-to-local.mjs",
    "db:sync:preprod": "node scripts/sync-prod-to-preprod.mjs",
    "db:verify:prod": "node scripts/verify-prod-timetrack.mjs",
    "identity:preflight": "node server/identity_preflight.mjs",
    "identity:resolve": "node server/resolve_employee_identity.mjs",
    "duration:preflight": "node server/duration_preflight.mjs",
    "duration:backfill": "node server/backfill_time_entry_minutes.mjs",
    "tenant:preflight": "node server/tenant_rls_preflight.mjs",
    "tenant:rls:enable": "node server/enable_tenant_rls.mjs",
    "dns:update": "node scripts/update-namecheap-dns.mjs",
    "dns:watch": "node scripts/dns-watchdog.mjs",
    "postinstall": "cd server && npm install",
    "build": "vite build && node scripts/generate-static-legal-pages.mjs && cd server && npm run build",
    "start": "node scripts/production-start.mjs",
    "start:dev-db": "cd server && npx prisma db push --schema=prisma/schema.prisma && cd .. && node server/dist/index.js",
    "typecheck": "tsc -p ./tsconfig.json --noEmit && cd server && npx tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:mojibake": "node scripts/check-mojibake.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:sanity": "node scripts/predeploy-check.mjs",
    "owner:gate": "node scripts/owner-gate-check.mjs",
    "test:e2e": "playwright test",
    "screenshots:store": "node scripts/capture-store-screenshots.mjs",
    "predeploy": "node scripts/predeploy-check.mjs",
    "predeploy:limitations": "node scripts/predeploy-limitations.mjs",
    "submit:ios": "node scripts/submit-to-app-store.mjs",
    "review:ios": "node scripts/add-for-review-asc.mjs",
    "release:ios": "node scripts/release-ios-asc.mjs",
    "verify:stores": "node scripts/verify-store-release.mjs",
    "update:ios": "node scripts/update-ios-review-build.mjs",
    "browser:asc": "node scripts/open-browser-asc.mjs",
    "play:closedalpha": "node scripts/update-closed-alpha-vc15.mjs",
    "play:production": "node scripts/promote-production-vc15.mjs",
    "play:verify": "node scripts/verify-closed-alpha-release.mjs",
    "play:watch": "node scripts/watch-play-review.mjs",
    "prepare": "husky || exit 0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.37",
    "expo-background-fetch": "~14.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.475.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
