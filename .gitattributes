# Normalize line endings: LF in the working tree for all text files,
# CRLF only where the platform demands it (PowerShell scripts).
# Prevents the recurring "LF will be replaced by CRLF" churn seen on Windows.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files — never mangle these.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.aab binary
*.ipa binary
*.apk binary
*.p8 binary
*.dump binary
